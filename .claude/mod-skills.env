PROBE_DIM='minecraft:{world}'
PROBE_CREATE='worlds create {dim} from-dimension minecraft:{kind}'
PROBE_KIND='overworld'
PROBE_KINDS='overworld the_nether the_end'
COMPAT_MODS='worldthreader'
COMPAT_CMD='gamerule worldthreader:debug true; worlds create a:w1; @await created 600; worlds group create test:a; execute in a:w1 run worlds group join test:a; wait:5; execute in a:w1 run setworldspawn 0 100 0; wait:5; @fake minecraft:overworld; fake:give @s diamond 3; wait:5; fake:execute in minecraft:the_nether run tp @s 0 100 0; wait:10; @player; fake:execute in a:w1 run tp @s 5 100 5; wait:10; @player; fake:give @s dirt 7; wait:5; fake:execute in minecraft:overworld run tp @s 0 100 0; wait:10; @player; fake:execute in a:w1 run tp @s 5 100 5; wait:10; @player; fake:kill @s; wait:5; @respawn; wait:10; @player; execute in a:w1 run time query gametime; wait:1300; @levels'
COMPAT_EXPECT=(
  'player minecraft:the_nether .* items=3 '
  'player a:w1 .* items=0 '
  'player minecraft:overworld .* items=3 '
  'player a:w1 .* items=7 '
  'respawn a:w1 '
)
